<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenLyrics.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenLyrics"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OpenLyrics">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" MinWidth="250" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="ClearProjectionAccelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Modifiers="Control,Shift" Invoked="CloseProjectorAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- Left panel: session (top) and library (bottom) -->
        <Grid Grid.Column="0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Current session" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ListView x:Name="SessionList"
                          Grid.Row="1"
                          DisplayMemberPath="Title"
                          BorderThickness="1"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          SelectionChanged="SessionList_SelectionChanged" />
                <Button x:Name="RemoveFromSessionButton" Grid.Row="2" Content="Remove from session" Click="RemoveFromSessionButton_Click" />
            </Grid>

            <Grid Grid.Row="1" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Library" Style="{StaticResource SubtitleTextBlockStyle}" />
                <AutoSuggestBox x:Name="SearchBox"
                                Grid.Row="1"
                                PlaceholderText="Search title or lyrics"
                                QueryIcon="Find"
                                TextChanged="SearchBox_TextChanged" />
                <ListView x:Name="LibraryList"
                          Grid.Row="2"
                          DisplayMemberPath="Title"
                          BorderThickness="1"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          SelectionChanged="LibraryList_SelectionChanged"
                          DoubleTapped="LibraryList_DoubleTapped" />
                <Button x:Name="AddToSessionButton" Grid.Row="3" Content="Add to session" Click="AddToSessionButton_Click" />
                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                    <Button x:Name="NewSongButton" Content="New" Click="NewSongButton_Click" />
                    <Button x:Name="SaveSongButton" Content="Save" Click="SaveSongButton_Click" />
                    <Button x:Name="DeleteSongButton" Content="Delete" Click="DeleteSongButton_Click" />
                </StackPanel>
                <Button x:Name="ImportXmlButton" Grid.Row="5" Content="Import from XML..." Click="ImportXmlButton_Click" Margin="0,6,0,0" HorizontalAlignment="Stretch" />
            </Grid>
        </Grid>

        <!-- Center: editor -->
        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox x:Name="EditorTitle"
                     PlaceholderText="Song title"
                     FontSize="20"
                     TextChanged="EditorTitle_TextChanged" />

            <TextBox x:Name="EditorDescription"
                     Grid.Row="1"
                     PlaceholderText="Description (session only, not saved to library)"
                     TextWrapping="Wrap"
                     TextChanged="EditorDescription_TextChanged" />

            <TextBox x:Name="LyricsEditor"
                     Grid.Row="2"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontFamily="Segoe UI"
                     FontSize="18"
                     IsSpellCheckEnabled="False"
                     PlaceholderText="Type or paste lyrics here (ă â î ș ț). Separate slides with a blank line or ---"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     TextChanged="LyricsEditor_TextChanged" />

            <StackPanel Grid.Row="3" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PrevButton" Content="&lt; Previous" Click="PrevButton_Click" />
                    <Button x:Name="NextButton" Content="Next &gt;" Click="NextButton_Click" />
                    <Button x:Name="ProjectButton" Content="Project" Click="ProjectButton_Click" Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CloseProjectionButton" Content="Close projection" Click="CloseProjectionButton_Click" />
                    <Button x:Name="SettingsButton" Content="Settings" Click="SettingsButton_Click" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Right panel: preview (top) and slides (bottom) -->
        <Grid Grid.Column="2" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Preview" Style="{StaticResource SubtitleTextBlockStyle}" />

            <Border Grid.Row="1" Background="Black" CornerRadius="4">
                <Viewbox Stretch="Uniform">
                    <Grid Width="1920" Height="1080" Padding="80">
                        <TextBlock x:Name="PreviewText"
                                   Foreground="White"
                                   FontFamily="Segoe UI"
                                   FontSize="80"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Viewbox>
            </Border>

            <TextBlock Grid.Row="2" Text="Slides" Style="{StaticResource SubtitleTextBlockStyle}" />

            <ListView x:Name="SlidesList"
                      Grid.Row="3"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      SelectionChanged="SlidesList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,6" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>
