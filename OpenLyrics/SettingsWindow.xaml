<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenLyrics.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenLyrics"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OpenLyrics Settings">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <ScrollViewer Padding="16">
        <StackPanel Spacing="16">

            <StackPanel Spacing="8">
                <TextBlock Text="Projector" Style="{StaticResource SubtitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Monitor" VerticalAlignment="Center" />
                    <ComboBox x:Name="MonitorCombo" MinWidth="240" SelectionChanged="MonitorCombo_SelectionChanged" />
                    <Button x:Name="RefreshMonitorsButton" Content="Refresh" Click="RefreshMonitorsButton_Click" />
                </StackPanel>
                <CheckBox x:Name="FullMonitorCheck" Content="Fill entire screen with text (no custom region)" IsChecked="True" Click="FullMonitorCheck_Click" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="X" VerticalAlignment="Center" />
                    <NumberBox x:Name="RegionXBox" Width="80" SpinButtonPlacementMode="Compact" ValueChanged="RegionBox_ValueChanged" />
                    <TextBlock Text="Y" VerticalAlignment="Center" />
                    <NumberBox x:Name="RegionYBox" Width="80" SpinButtonPlacementMode="Compact" ValueChanged="RegionBox_ValueChanged" />
                    <TextBlock Text="W" VerticalAlignment="Center" />
                    <NumberBox x:Name="RegionWidthBox" Width="80" SpinButtonPlacementMode="Compact" ValueChanged="RegionBox_ValueChanged" />
                    <TextBlock Text="H" VerticalAlignment="Center" />
                    <NumberBox x:Name="RegionHeightBox" Width="80" SpinButtonPlacementMode="Compact" ValueChanged="RegionBox_ValueChanged" />
                </StackPanel>
                <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Height="160">
                    <Canvas x:Name="MonitorPreviewCanvas" Background="Transparent">
                        <Rectangle x:Name="MonitorPreviewRect" Fill="#332A82DA" Stroke="#FF2A82DA" StrokeThickness="2"
                                   PointerPressed="MonitorPreviewRect_PointerPressed"
                                   PointerMoved="MonitorPreviewRect_PointerMoved"
                                   PointerReleased="MonitorPreviewRect_PointerReleased" />
                        <Rectangle x:Name="ResizeHandle" Width="12" Height="12" Fill="#FF2A82DA"
                                   PointerPressed="ResizeHandle_PointerPressed"
                                   PointerMoved="ResizeHandle_PointerMoved"
                                   PointerReleased="ResizeHandle_PointerReleased" />
                    </Canvas>
                </Border>
                <CheckBox x:Name="AutoSplitCheck" Content="Auto-split slides that overflow the projector" Click="AutoSplitCheck_Click" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Max rows per slide (0 = unlimited)" VerticalAlignment="Center" />
                    <NumberBox x:Name="MaxDisplayRowsBox" Width="80" Minimum="0" SpinButtonPlacementMode="Compact" ValueChanged="MaxDisplayRowsBox_ValueChanged" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Slide splitting" Style="{StaticResource SubtitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Delimiters" VerticalAlignment="Center" />
                    <TextBox x:Name="DelimitersBox" Width="160" PlaceholderText="--- ; ===" LostFocus="DelimitersBox_LostFocus" />
                    <CheckBox x:Name="BlankLineCheck" Content="Blank line splits" Click="BlankLineCheck_Click" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Font &amp; style" Style="{StaticResource SubtitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Font" VerticalAlignment="Center" />
                    <ComboBox x:Name="FontCombo" Width="140" SelectionChanged="StyleControl_Changed">
                        <x:String>Segoe UI</x:String>
                        <x:String>Arial</x:String>
                        <x:String>Calibri</x:String>
                        <x:String>Georgia</x:String>
                        <x:String>Verdana</x:String>
                    </ComboBox>
                    <TextBlock Text="Size" VerticalAlignment="Center" />
                    <NumberBox x:Name="FontSizeBox" Width="80" SpinButtonPlacementMode="Compact" ValueChanged="StyleControl_ValueChanged" />
                    <TextBlock Text="Color" VerticalAlignment="Center" />
                    <ComboBox x:Name="ColorCombo" Width="110" SelectionChanged="StyleControl_Changed">
                        <x:String>White</x:String>
                        <x:String>Black</x:String>
                        <x:String>Yellow</x:String>
                        <x:String>Red</x:String>
                        <x:String>Cyan</x:String>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Align" VerticalAlignment="Center" />
                    <ComboBox x:Name="AlignCombo" Width="110" SelectionChanged="StyleControl_Changed">
                        <x:String>Center</x:String>
                        <x:String>Left</x:String>
                        <x:String>Right</x:String>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Background" Style="{StaticResource SubtitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Mode" VerticalAlignment="Center" />
                    <ComboBox x:Name="BackgroundModeCombo" Width="120" SelectionChanged="BackgroundControl_Changed">
                        <x:String>Transparent</x:String>
                        <x:String>Color</x:String>
                        <x:String>Image</x:String>
                        <x:String>Video</x:String>
                    </ComboBox>
                    <ComboBox x:Name="BackgroundColorCombo" Width="110" SelectionChanged="BackgroundControl_Changed">
                        <x:String>Black</x:String>
                        <x:String>White</x:String>
                        <x:String>Green</x:String>
                        <x:String>Blue</x:String>
                    </ComboBox>
                    <Button x:Name="BrowseImageButton" Content="Choose Image..." Click="BrowseImageButton_Click" />
                    <Button x:Name="BrowseVideoButton" Content="Choose Video..." Click="BrowseVideoButton_Click" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
